#if /* use CLN */ @AVA6_USE_CLN_IMP@
#  define AVA6_CLN_IMP
#endif /* @AVA6_USE_CLN_IMP@ */
#if /* use GMP */ @AVA6_USE_GMP_IMP@
#  define AVA6_GMP_IMP
#endif /* @AVA6_USE_GMP_IMP@ */

#ifdef AVA6_CLN_IMP
#  include "util/rational_cln_imp.h"
#endif /* AVA6_CLN_IMP */

#ifdef AVA6_GMP_IMP
#  include "util/rational_gmp_imp.h"
#endif /* AVA6_GMP_IMP */
